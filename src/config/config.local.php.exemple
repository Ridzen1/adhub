/**
 * MODÈLE DE CONFIGURATION — À COPIER, PAS À MODIFIER ICI.
 *
 * Sur l'hébergement :
 *   1. copier ce fichier en config.local.php (dans le même dossier)
 *   2. y renseigner les identifiants réels
 *   3. NE JAMAIS versionner ni téléverser config.local.php depuis le poste de dev
 *
 * En local (Docker), ce fichier n'existe pas : les identifiants viennent alors
 * des variables d'environnement de docker-compose.yml.
 */

return [
    'db' => [
        // Sur o2switch, l'hôte est 'localhost'
        'host' => 'localhost',

        // Nom complet donné par cPanel, préfixé par le compte : ex. abcd1234_adhub
        'name' => 'PREFIXE_adhub',

        // Utilisateur MySQL dédié, également préfixé : ex. abcd1234_adhub
        'user' => 'PREFIXE_adhub',

        // Mot de passe généré par cPanel — long et aléatoire
        'pass' => 'A_REMPLACER',
    ],

    // Envoi des e-mails (code de connexion à 6 chiffres). Facultatif : sans ce bloc,
    // ADHUB envoie depuis ne-pas-repondre@ad-hub.fr avec la fonction mail() d'o2switch.
    'mail' => [
        'expediteur'     => 'ne-pas-repondre@ad-hub.fr', // adresse d'un domaine hébergé sur le compte o2switch
        'expediteur_nom' => "AD'HUB",
        // Invitations et « mot de passe oublié » : une vraie boîte qui reçoit les réponses
        'expediteur_comptes' => 'contact@ad-hub.fr',
    ],

    // Adresse publique utilisée dans les liens des e-mails (par défaut https://ad-hub.fr)
    // 'url_site' => 'https://ad-hub.fr',

    // Interrupteur de secours : mettre false UNIQUEMENT si les e-mails n'arrivent plus
    // et que plus personne ne peut se connecter. La connexion repasse alors au mot de
    // passe seul (sauf comptes avec application d'authentification). Remettre true ensuite.
    'double_auth_email' => true,
];
